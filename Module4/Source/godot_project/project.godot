; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Pusaka3D Temple Tour"
config/description="Module 4 reference project: FK/IK arm demo, Catmull-Rom camera fly-through of the Pusaka3D temple, and a walking figure used for the foot-slide diagnose-and-fix task."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.06, 0.08, 0.12, 1)
